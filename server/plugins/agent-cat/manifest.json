      "options": [
        { "value": "auto", "label": "用得最多的" },
        { "value": "claude:5h", "label": "Claude 5h" },
        { "value": "claude:7d", "label": "Claude 7d" },
        { "value": "codex:5h", "label": "Codex 5h" },
        { "value": "codex:7d", "label": "Codex 7d" },
        { "value": "off", "label": "不显示" }
