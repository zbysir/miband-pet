<template>
  <!-- 对照实验：用快应用原生写法手写 Agent 猫，和插件渲染器比速度。单独一个应用，数据用内置的快照（不接 Mac），点击耗时发给 Mac 记日志 -->
  <div class="page" style="height: {{pageH}}px">
    <swiper id="pager" class="pager" style="height: {{pageH}}px" vertical="true" loop="false" indicator="false" @change="pageChange">
      <div class="cat" style="height: {{pageH}}px">
        <text class="headline" style="color: {{headColor}}">{{headline}}</text>
        <div class="quota">
          <block if="{{quota.show}}">
            <text class="quota-name">{{quota.name}}</text>
            <div class="quota-track">
              <div class="quota-fill" style="width: {{quota.w}}px; background-color: {{quota.color}}"></div>
            </div>
            <text class="quota-pct" style="color: {{quota.color}}">{{quota.text}}</text>
          </block>
        </div>
        <div class="sprite-box" @click="next">
          <image class="sprite" src="{{frame}}"></image>
        </div>
        <div if="{{bubble.show}}" class="bubble" style="border-color: {{bubble.color}}" @click="next">
          <div class="bubble-row">
            <text class="bubble-project">{{bubble.project}}</text>
            <text if="{{bubble.count}}" class="bubble-count">{{bubble.count}}</text>
          </div>
          <text class="bubble-title">{{bubble.title}}</text>
        </div>
        <div else class="bubble-empty"></div>
        <div class="status">
          <div if="{{counts.blocked > 0}}" class="dot-group">
            <div class="dot" style="background-color: #ff9f1c"></div>
            <text class="dot-n">{{counts.blocked}}</text>
          </div>
          <div class="dot-group">
            <div class="dot" style="background-color: #2ea0ff"></div>
            <text class="dot-n">{{counts.working}}</text>
          </div>
          <div class="dot-group">
            <div class="dot" style="background-color: #3ddc84"></div>
            <text class="dot-n">{{counts.done}}</text>
          </div>
          <div class="dot-group">
            <div class="dot" style="background-color: #5c6068"></div>
            <text class="dot-n">{{counts.idle}}</text>
          </div>
          <div class="spacer"></div>
          <div class="tally" @click="openToday">
            <text if="{{costText}}" class="cost" style="color: {{costColor}}">{{costText}}</text>
            <image class="fish" src="/common/pet/fish.png"></image>
            <text class="fish-n" style="color: {{fishColor}}">{{fish}}</text>
          </div>
        </div>
      </div>
      <div class="today" style="height: {{pageH}}px">
        <div class="today-head">
          <text class="today-title">今日</text>
          <div class="spacer"></div>
          <text class="today-date">{{dateText}}</text>
        </div>
        <div class="blocks">
          <div class="block" @click="pick('done')">
            <div class="block-row">
              <image class="block-fish" src="/common/pet/fish.png"></image>
              <text class="block-num" style="color: #e29640">{{fish}}</text>
            </div>
            <text class="block-label">完成的任务</text>
            <div class="mark" style="background-color: {{metric === 'done' ? '#e29640' : '#22252c'}}"></div>
          </div>
          <div class="spacer"></div>
          <div class="block" @click="pick('usd')">
            <text class="block-num" style="color: #6fb6ff">{{costBig}}</text>
            <text class="block-label">Claude 花的钱</text>
            <div class="mark" style="background-color: {{metric === 'usd' ? '#6fb6ff' : '#22252c'}}"></div>
          </div>
        </div>
        <div class="chart">
          <div class="bar-col" for="{{bars}}" tid="date">
            <text class="bar-label" style="color: {{$item.labelColor}}">{{$item.label}}</text>
            <div class="bar" style="height: {{$item.h}}px; background-color: {{$item.color}}"></div>
            <text class="bar-day" style="color: {{$item.dayColor}}">{{$item.weekday}}</text>
          </div>
        </div>
        <text class="section">额度</text>
        <div class="q-row" for="{{quotas}}" tid="label">
          <text class="q-label">{{$item.label}}</text>
          <div class="q-track">
            <div class="q-fill" style="width: {{$item.w}}px; background-color: {{$item.color}}"></div>
          </div>
          <div class="spacer"></div>
          <text class="q-text">{{$item.text}}</text>
        </div>
      </div>
    </swiper>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import device from '@system.device'
import vibrator from '@system.vibrator'
import demo from '../../common/demo.js'

const PRIORITY = { blocked: 0, done: 1, working: 2, idle: 3, unknown: 4 }
const COLOR = { blocked: '#ff9f1c', working: '#2ea0ff', done: '#3ddc84', idle: '#5c6068', unknown: '#5c6068' }
const HEAD_COLOR = { alert: '#ff9f1c', impatient: '#ff5c5c', work: '#2ea0ff', celebrate: '#3ddc84', sleep: '#c9ced8' }
const FRAMES = { work: 6, alert: 6, celebrate: 6, sleep: 8 }
const ACTION = { alert: ['alert', 2800], impatient: ['alert', 1200], work: ['work', 3600], celebrate: ['celebrate', 3200], sleep: ['sleep', 9600] }
const METRIC = {
  done: { today: '#e29640', other: '#5c4a3a' },
  usd: { today: '#6fb6ff', other: '#2b4060' }
}
const WEEKDAYS = ['日', '一', '二', '三', '四', '五', '六']
const CELEBRATE_MS = 8000
const CHART_H = 40
const S = 'agent-cat:'

function fmtUsd(v) {
  if (v < 100) return '$' + v.toFixed(2)
  if (v < 1000) return '$' + v.toFixed(1)
  return '$' + Math.round(v)
}
function fmtUsdShort(v) {
  if (v < 10) return '$' + v.toFixed(1)
  if (v < 1000) return '$' + Math.round(v)
  return '$' + (v / 1000).toFixed(1) + 'k'
}
function fmtReset(sec) {
  const left = Math.max(0, sec - Date.now() / 1000)
  if (left >= 86400) return Math.floor(left / 86400) + ' 天'
  const h = Math.floor(left / 3600)
  const m = Math.floor((left % 3600) / 60)
  return h + ':' + (m < 10 ? '0' : '') + m
}
function usedColor(u) {
  return u >= 80 ? '#ff6b6b' : u >= 50 ? '#ff9f1c' : '#3ddc84'
}
function byProjectThenId(x, y) {
  return (x.project || '').localeCompare(y.project || '') || (x.id < y.id ? -1 : x.id > y.id ? 1 : 0)
}

export default {
  private: {
    pageH: 303,
    headline: '都在休息 zZ',
    headColor: '#c9ced8',
    quota: { show: false, name: '', w: 4, color: '#3ddc84', text: '' },
    frame: '/common/pet/gray/sleep_0.png',
    bubble: { show: false, project: '', title: '', count: '', color: '#5c6068' },
    counts: { blocked: 0, working: 0, done: 0, idle: 0 },
    costText: '',
    costColor: '#5c6068',
    costBig: '$0.00',
    fish: 0,
    fishColor: '#5c6068',
    dateText: '',
    metric: 'done',
    bars: [],
    quotas: []
  },

  onInit() {
    this.stores = Object.assign({}, demo)
    this.prevStatus = null
    this.focusId = ''
    this.pool = []
    this.prevStatus = null
    this.celebrateUntil = 0
    this.warned = {}
    this.anim = null
    this.page = 0
    this.heard = false
    this.conn = interconnect.instance()
    this.tick = setInterval(() => this.refresh('tick'), 20000)
  },

  onShow() {
    device.getInfo({
      success: (info) => {
        const w = info.screenWidth || 0
        const h = info.screenHeight || 0
        if (w > 0 && h > 0) this.pageH = Math.round(h / (w / 212))
      }
    })
    this.refresh('show')
  },

  onHide() {
    this.stopAnim()
  },

  onDestroy() {
    this.stopAnim()
    clearInterval(this.tick)
  },

  send(obj) {
    try {
      this.conn.send({ data: obj, success: () => {}, fail: () => {} })
    } catch (e) {}
  },

  log(msg) {
    this.send({ t: 'log', p: '', level: 'info', msg: msg })
  },

  // ---------- 数据 → 界面 ----------

  refresh(what) {
    const st = this.stores
    const agents = st[S + 'agents'] || []
    const config = st[S + 'config'] || {}
    const skin = config.skin || 'orange'
    const now = Date.now()

    // 庆祝：有 agent 从 working 变成 done/idle
    if (what === S + 'agents') {
      if (this.prevStatus) {
        for (const a of agents) {
          const b = this.prevStatus[a.id]
          if (b === 'working' && (a.status === 'done' || a.status === 'idle')) this.celebrateUntil = now + CELEBRATE_MS
        }
      }
      this.prevStatus = {}
      for (const a of agents) this.prevStatus[a.id] = a.status
      if (this.celebrateUntil > now) setTimeout(() => this.refresh('celebrate'), CELEBRATE_MS + 50)
    }

    const n = { blocked: 0, working: 0, done: 0, idle: 0 }
    for (const a of agents) if (n[a.status] !== undefined) n[a.status]++
    const limit = config.impatientMin == null ? 5 : config.impatientMin
    let worst = null
    let mins = 0
    if (limit > 0) {
      for (const a of agents) {
        if (a.status !== 'blocked' || !a.since) continue
        const m = Math.floor((now - a.since) / 60000)
        if (m >= limit && m > mins) {
          worst = a
          mins = m
        }
      }
    }
    if (worst && !this.warned[worst.id + ':' + worst.since]) {
      this.warned[worst.id + ':' + worst.since] = true
      vibrator.vibrate({ mode: 'long' })
    }
    let mood = 'sleep'
    let headline = n.done > 0 ? '都完成啦' : '都在休息 zZ'
    if (worst) {
      mood = 'impatient'
      headline = (worst.project || worst.agent) + ' 等了 ' + mins + ' 分钟！'
    } else if (n.blocked > 0) {
      mood = 'alert'
      headline = n.blocked + ' 个等你处理！'
    } else if (this.celebrateUntil > now) {
      mood = 'celebrate'
      headline = '搞定一个！'
    } else if (n.working > 0) {
      mood = 'work'
      headline = n.working + ' 个在忙'
    }
    this.headline = headline
    this.headColor = HEAD_COLOR[mood]
    this.counts.blocked = n.blocked
    this.counts.working = n.working
    this.counts.done = n.done
    this.counts.idle = n.idle
    this.startAnim(skin, ACTION[mood][0], ACTION[mood][1])

    // 气泡
    const sorted = agents.slice().sort((x, y) => (PRIORITY[x.status] === undefined ? 4 : PRIORITY[x.status]) - (PRIORITY[y.status] === undefined ? 4 : PRIORITY[y.status]) || (y.seq || 0) - (x.seq || 0) || byProjectThenId(x, y))
    const top = sorted.filter((a) => a.status !== 'idle' && a.status !== 'unknown')
    this.pool = top.length > 0 ? top : sorted
    this.showBubble()

    // 额度
    const which = config.quota || 'auto'
    let best = null
    if (which !== 'off') {
      const parts = which !== 'auto' ? which.split(':') : []
      for (const src of st[S + 'usage'] || []) {
        if (parts[0] && src.agent !== parts[0]) continue
        for (const w of src.windows || []) {
          if (parts[1] && w.name !== parts[1]) continue
          if (!best || w.used > best.used) best = Object.assign({ agent: src.agent === 'claude' ? 'Claude' : src.agent === 'codex' ? 'Codex' : src.agent }, w)
        }
      }
    }
    if (best) {
      const pct = Math.min(100, Math.max(0, best.used))
      this.quota.show = true
      this.quota.name = best.agent + ' ' + best.name
      this.quota.w = Math.max(4, Math.round((pct / 100) * 68))
      this.quota.color = usedColor(best.used)
      this.quota.text = Math.round(best.used) + '%' + (best.resetsAt ? ' ' + fmtReset(best.resetsAt) : '')
    } else this.quota.show = false

    // 钱数、小鱼干
    const stats = st[S + 'stats'] || { today: { done: 0 }, days: [] }
    const cost = st[S + 'cost']
    this.fish = stats.today.done
    this.fishColor = stats.today.done > 0 ? '#e29640' : '#5c6068'
    this.costText = cost ? fmtUsdShort(cost.today) : ''
    this.costColor = cost && cost.today > 0 ? '#6fb6ff' : '#5c6068'
    this.costBig = cost ? fmtUsd(cost.today) : '$0.00'

    // 今日页
    const d = new Date()
    this.dateText = (d.getMonth() + 1) + '月' + d.getDate() + '日 周' + WEEKDAYS[d.getDay()]
    this.drawChart()
    const qs = []
    for (const src of st[S + 'usage'] || []) {
      for (const w of src.windows || []) {
        qs.push({
          label: (src.agent === 'claude' ? 'Claude' : src.agent === 'codex' ? 'Codex' : src.agent) + ' ' + w.name,
          w: Math.max(2, Math.round((Math.min(100, Math.max(0, w.used)) / 100) * 62)),
          color: usedColor(w.used),
          text: Math.round(w.used) + '%' + (w.resetsAt ? ' ' + fmtReset(w.resetsAt) : '')
        })
      }
    }
    this.quotas = qs.slice(0, 4)
  },

  showBubble() {
    const pool = this.pool
    const index = Math.max(0, pool.findIndex((a) => a.id === this.focusId))
    const f = pool[index]
    if (!f) {
      this.bubble.show = false
      return
    }
    this.bubble.show = true
    this.bubble.project = f.project || f.agent || '?'
    this.bubble.title = f.title || ''
    this.bubble.count = pool.length > 1 ? (index + 1) + '/' + pool.length : ''
    this.bubble.color = COLOR[f.status] || COLOR.unknown
  },

  drawChart() {
    const st = this.stores
    const stats = st[S + 'stats'] || { days: [] }
    const cost = st[S + 'cost']
    const metric = cost ? this.metric : 'done'
    const days = metric === 'usd' ? cost.days.map((x) => ({ date: x.date, weekday: x.weekday, value: x.usd })) : (stats.days || []).map((x) => ({ date: x.date, weekday: x.weekday, value: x.done }))
    const m = METRIC[metric]
    let topV = metric === 'usd' ? 0.01 : 1
    for (const x of days) if (x.value > topV) topV = x.value
    this.bars = days.map((x, i) => {
      const today = i === days.length - 1
      return {
        date: x.date,
        weekday: x.weekday,
        label: x.value > 0 ? (metric === 'usd' ? fmtUsdShort(x.value) : String(x.value)) : '',
        labelColor: today ? m.today : '#8a8f98',
        h: Math.max(2, Math.round((x.value / topV) * CHART_H)),
        color: today ? m.today : m.other,
        dayColor: today ? '#ffffff' : '#5c6068'
      }
    })
  },

  // 猫的动画：定时换图（不用 image-animator，9 Pro 上拆掉它会重启）
  startAnim(skin, action, duration) {
    const key = skin + '/' + action + '/' + duration
    if (this.anim && this.anim.key === key) return
    this.stopAnim()
    const n = FRAMES[action]
    let i = 0
    this.frame = '/common/pet/' + skin + '/' + action + '_0.png'
    this.anim = {
      key,
      timer: setInterval(() => {
        i = (i + 1) % n
        this.frame = '/common/pet/' + skin + '/' + action + '_' + i + '.png'
      }, Math.max(50, Math.round(duration / n)))
    }
  },

  stopAnim() {
    if (this.anim) clearInterval(this.anim.timer)
    this.anim = null
  },

  // ---------- 点击 ----------

  timed(name, fn) {
    const t0 = Date.now()
    fn()
    const t1 = Date.now()
    setTimeout(() => this.log('原生 ' + name + ' ' + (Date.now() - t0) + 'ms：JS ' + (t1 - t0) + ' 框架 ' + (Date.now() - t1)), 0)
  },

  next() {
    this.timed('点气泡', () => {
      const pool = this.pool
      if (pool.length < 2) return
      const index = Math.max(0, pool.findIndex((a) => a.id === this.focusId))
      this.focusId = pool[(index + 1) % pool.length].id
      this.showBubble()
    })
  },

  pick(m) {
    this.timed('切' + (m === 'usd' ? '钱数' : '小鱼干'), () => {
      this.metric = m
      this.drawChart()
    })
  },

  openToday() {
    try {
      this.$element('pager').swipeTo({ index: 1 })
    } catch (e) {}
  },

  pageChange(evt) {
    this.page = evt.index
  }
}
</script>

<style>
.page { width: 212px; flex-direction: column; background-color: #000000; }
.pager { width: 212px; }
.spacer { flex-grow: 1; }
.cat { width: 212px; flex-direction: column; align-items: center; padding-top: 8px; padding-left: 10px; padding-right: 10px; background-color: #0a0c12; }
.headline { width: 192px; height: 26px; lines: 1; text-overflow: ellipsis; font-size: 18px; font-weight: bold; text-align: center; }
.quota { width: 192px; height: 20px; flex-direction: row; align-items: center; }
.quota-name { width: 64px; font-size: 12px; color: #e8ebf1; lines: 1; }
.quota-track { width: 68px; height: 8px; border-radius: 4px; background-color: #2a2e36; }
.quota-fill { height: 8px; border-radius: 4px; }
.quota-pct { width: 60px; font-size: 12px; text-align: right; lines: 1; }
.sprite-box { width: 192px; height: 142px; margin-top: 2px; justify-content: center; align-items: center; }
.sprite { width: 140px; height: 140px; }
.bubble { width: 192px; height: 62px; margin-top: 6px; padding-top: 6px; padding-bottom: 6px; padding-left: 10px; padding-right: 10px; border-radius: 14px; background-color: #16191f; flex-direction: column; border-width: 2px; }
.bubble-empty { width: 192px; height: 62px; margin-top: 6px; }
.bubble-row { flex-direction: row; align-items: center; }
.bubble-project { flex: 1; font-size: 14px; font-weight: bold; lines: 1; text-overflow: ellipsis; color: #ffffff; }
.bubble-count { margin-left: 6px; font-size: 11px; color: #8a8f98; }
.bubble-title { font-size: 12px; color: #8a8f98; lines: 1; text-overflow: ellipsis; }
.status { width: 192px; height: 22px; margin-top: 8px; flex-direction: row; align-items: center; }
.dot-group { flex-direction: row; align-items: center; margin-right: 8px; }
.dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 4px; }
.dot-n { font-size: 12px; color: #8a8f98; }
.tally { height: 22px; padding-left: 4px; flex-direction: row; align-items: center; }
.cost { margin-right: 6px; font-size: 12px; }
.fish { width: 24px; height: 12px; }
.fish-n { margin-left: 4px; font-size: 12px; }
.today { width: 212px; flex-direction: column; padding: 10px; background-color: #0a0c12; }
.today-head { flex-direction: row; align-items: center; }
.today-title { font-size: 18px; font-weight: bold; color: #ffffff; }
.today-date { font-size: 11px; color: #8a8f98; }
.blocks { flex-direction: row; align-items: center; margin-top: 6px; }
.block { width: 92px; flex-direction: column; padding-top: 4px; padding-bottom: 4px; padding-left: 6px; padding-right: 6px; }
.block-row { flex-direction: row; align-items: center; }
.block-fish { width: 28px; height: 14px; margin-right: 6px; }
.block-num { font-size: 20px; font-weight: bold; lines: 1; }
.block-label { font-size: 11px; color: #8a8f98; }
.mark { width: 20px; height: 2px; margin-top: 3px; border-radius: 1px; }
.chart { width: 192px; margin-top: 8px; flex-direction: row; justify-content: space-between; align-items: flex-end; }
.bar-col { width: 26px; flex-direction: column; align-items: center; }
.bar-label { font-size: 9px; lines: 1; }
.bar { width: 14px; margin-top: 2px; border-radius: 3px; }
.bar-day { font-size: 10px; margin-top: 3px; }
.section { font-size: 12px; color: #8a8f98; margin-top: 10px; }
.q-row { width: 192px; height: 16px; margin-top: 4px; flex-direction: row; align-items: center; }
.q-label { width: 66px; font-size: 11px; color: #c9ced8; lines: 1; }
.q-track { width: 62px; height: 6px; border-radius: 3px; background-color: #22252c; }
.q-fill { height: 6px; border-radius: 3px; }
.q-text { font-size: 10px; color: #8a8f98; }
</style>
