<template>
  <!-- tools/gen_template.py 生成，不要手改 -->
  <div class="page" style="height: {{pageH}}px" @swipe="onSwipe">
    <div if="{{root && root.t !== 'w'}}" id="{{root.i}}" style="{{root.s}}" @click="tap(root.i, root.e)" @longpress="hold(root.i, root.e)">
      <block for="{{s1 in root.c}}" tid="k">
        <block for="{{n1 in s1.w}}" tid="k">
          <div if="{{n1.t === 'v'}}" id="{{n1.i}}" style="{{n1.s}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)">
            <block for="{{s2 in n1.c}}" tid="k">
              <block for="{{n2 in s2.w}}" tid="k">
                <div if="{{n2.t === 'v'}}" id="{{n2.i}}" style="{{n2.s}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)">
                  <block for="{{s3 in n2.c}}" tid="k">
                    <block for="{{n3 in s3.w}}" tid="k">
                      <div if="{{n3.t === 'v'}}" id="{{n3.i}}" style="{{n3.s}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)">
                        <block for="{{s4 in n3.c}}" tid="k">
                          <block for="{{n4 in s4.w}}" tid="k">
                            <div if="{{n4.t === 'v'}}" id="{{n4.i}}" style="{{n4.s}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)">
                              <block for="{{s5 in n4.c}}" tid="k">
                                <block for="{{n5 in s5.w}}" tid="k">
                                  <div if="{{n5.t === 'v'}}" id="{{n5.i}}" style="{{n5.s}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)"></div>
                                  <text elif="{{n5.t === 'x'}}" id="{{n5.i}}" style="{{n5.s}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)">{{n5.x}}</text>
                                  <image elif="{{n5.t === 'm' || n5.t === 'a'}}" id="{{n5.i}}" style="{{n5.s}}" src="{{n5.u}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)"></image>
                                </block>
                              </block>
                            </div>
                            <text elif="{{n4.t === 'x'}}" id="{{n4.i}}" style="{{n4.s}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)">{{n4.x}}</text>
                            <image elif="{{n4.t === 'm' || n4.t === 'a'}}" id="{{n4.i}}" style="{{n4.s}}" src="{{n4.u}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)"></image>
                          </block>
                        </block>
                      </div>
                      <text elif="{{n3.t === 'x'}}" id="{{n3.i}}" style="{{n3.s}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)">{{n3.x}}</text>
                      <image elif="{{n3.t === 'm' || n3.t === 'a'}}" id="{{n3.i}}" style="{{n3.s}}" src="{{n3.u}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)"></image>
                    </block>
                  </block>
                </div>
                <text elif="{{n2.t === 'x'}}" id="{{n2.i}}" style="{{n2.s}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)">{{n2.x}}</text>
                <image elif="{{n2.t === 'm' || n2.t === 'a'}}" id="{{n2.i}}" style="{{n2.s}}" src="{{n2.u}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)"></image>
              </block>
            </block>
          </div>
          <text elif="{{n1.t === 'x'}}" id="{{n1.i}}" style="{{n1.s}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)">{{n1.x}}</text>
          <image elif="{{n1.t === 'm' || n1.t === 'a'}}" id="{{n1.i}}" style="{{n1.s}}" src="{{n1.u}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)"></image>
        </block>
      </block>
    </div>
    <swiper elif="{{root}}" id="{{root.i}}" style="{{root.s}}" vertical="{{root.vt}}" loop="false" indicator="false" @change="pageChange(root.i, root.e)">
      <block for="{{s1 in root.c}}" tid="k">
        <block for="{{n1 in s1.w}}" tid="k">
          <div if="{{n1.t === 'v'}}" id="{{n1.i}}" style="{{n1.s}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)">
            <block for="{{s2 in n1.c}}" tid="k">
              <block for="{{n2 in s2.w}}" tid="k">
                <div if="{{n2.t === 'v'}}" id="{{n2.i}}" style="{{n2.s}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)">
                  <block for="{{s3 in n2.c}}" tid="k">
                    <block for="{{n3 in s3.w}}" tid="k">
                      <div if="{{n3.t === 'v'}}" id="{{n3.i}}" style="{{n3.s}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)">
                        <block for="{{s4 in n3.c}}" tid="k">
                          <block for="{{n4 in s4.w}}" tid="k">
                            <div if="{{n4.t === 'v'}}" id="{{n4.i}}" style="{{n4.s}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)">
                              <block for="{{s5 in n4.c}}" tid="k">
                                <block for="{{n5 in s5.w}}" tid="k">
                                  <div if="{{n5.t === 'v'}}" id="{{n5.i}}" style="{{n5.s}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)"></div>
                                  <text elif="{{n5.t === 'x'}}" id="{{n5.i}}" style="{{n5.s}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)">{{n5.x}}</text>
                                  <image elif="{{n5.t === 'm' || n5.t === 'a'}}" id="{{n5.i}}" style="{{n5.s}}" src="{{n5.u}}" @click="tap(n5.i, n5.e)" @longpress="hold(n5.i, n5.e)"></image>
                                </block>
                              </block>
                            </div>
                            <text elif="{{n4.t === 'x'}}" id="{{n4.i}}" style="{{n4.s}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)">{{n4.x}}</text>
                            <image elif="{{n4.t === 'm' || n4.t === 'a'}}" id="{{n4.i}}" style="{{n4.s}}" src="{{n4.u}}" @click="tap(n4.i, n4.e)" @longpress="hold(n4.i, n4.e)"></image>
                          </block>
                        </block>
                      </div>
                      <text elif="{{n3.t === 'x'}}" id="{{n3.i}}" style="{{n3.s}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)">{{n3.x}}</text>
                      <image elif="{{n3.t === 'm' || n3.t === 'a'}}" id="{{n3.i}}" style="{{n3.s}}" src="{{n3.u}}" @click="tap(n3.i, n3.e)" @longpress="hold(n3.i, n3.e)"></image>
                    </block>
                  </block>
                </div>
                <text elif="{{n2.t === 'x'}}" id="{{n2.i}}" style="{{n2.s}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)">{{n2.x}}</text>
                <image elif="{{n2.t === 'm' || n2.t === 'a'}}" id="{{n2.i}}" style="{{n2.s}}" src="{{n2.u}}" @click="tap(n2.i, n2.e)" @longpress="hold(n2.i, n2.e)"></image>
              </block>
            </block>
          </div>
          <text elif="{{n1.t === 'x'}}" id="{{n1.i}}" style="{{n1.s}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)">{{n1.x}}</text>
          <image elif="{{n1.t === 'm' || n1.t === 'a'}}" id="{{n1.i}}" style="{{n1.s}}" src="{{n1.u}}" @click="tap(n1.i, n1.e)" @longpress="hold(n1.i, n1.e)"></image>
        </block>
      </block>
    </swiper>
    <text if="{{!root}}" class="empty">{{connected ? '加载中…' : '等待 Mac 连接…'}}</text>
    <text if="{{root && !connected}}" class="offline">未连接 Mac</text>
  </div>
</template>

<script>
// 手环上的插件宿主：从 Mac 收插件代码、图片和数据，插件在手环本地跑（运行时见 common/runtime.js），
// 点击、滑动都在手环上处理，不经过 Mac。显示哪个插件由 Mac 决定（App 里切换）。界面树的格式见 tools/gen_template.py。
//
// Mac → 手环：
//   {t:'plugins', list: [{name, title, code, assets: {路径: 哈希}, err}]}   插件列表；code 是代码文件的哈希
//   {t:'blob', h, x: 'js' | 'png', k, n, b}   代码或图片分片（第 k 片，共 n 片，base64），收齐后写进 internal://files/<h>.<x>
//   {t:'store', name, v}                     数据（agents、settings…），插件里 useStore(name) 读
//   {t:'show', name}                         显示这个插件（App 里切换、提醒时切回猫）
//   {t:'vib', m: 'short' | 'long'}
// 手环 → Mac：
//   {t:'hello', w, h, have: [哈希…]}        打开或亮屏时；have 是手环上已有的代码和图片
//   {t:'bye'}                                离开前台
//   {t:'need', h: [哈希…]}                   缺这些代码或图片
//   {t:'nav', name}                          当前显示的插件（打开时、切换后）
//   {t:'log', p, level, msg}                 插件的 console 输出和出错信息
//   {t:'call', p, name, args}                插件让 Mac 做事（插件里 call(name, ...args)）
import interconnect from '@system.interconnect'
import storage from '@system.storage'
import device from '@system.device'
import file from '@system.file'
import vibrator from '@system.vibrator'
import createRuntime from '../../common/runtime.js'

const CACHE_KEY = 'state'
const FILES = 'internal://files/'
const MAX_DEPTH = 6 // 和 tools/gen_template.py 的 DEPTH 一致
const B64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
const B64MAP = {}
for (let i = 0; i < B64.length; i++) B64MAP[B64[i]] = i

function b64decode(s) {
  s = s.replace(/=+$/, '')
  const out = new Uint8Array(Math.floor(s.length * 3 / 4))
  let o = 0
  for (let i = 0; i < s.length; i += 4) {
    const a = B64MAP[s[i]], b = B64MAP[s[i + 1]], c = B64MAP[s[i + 2]], d = B64MAP[s[i + 3]]
    out[o++] = (a << 2) | (b >> 4)
    if (c !== undefined) out[o++] = ((b & 15) << 4) | (c >> 2)
    if (d !== undefined) out[o++] = ((c & 3) << 6) | d
  }
  return out
}

function text(id, style, x) {
  return { t: 'x', i: id, s: style, x }
}

function messageTree(title, msg, color) {
  return {
    t: 'v', i: 'msg', s: 'flex-direction:column;padding-top:24px;padding-left:12px;padding-right:12px;width:212px',
    c: [text('msg-t', 'font-size:16px;font-weight:bold;color:' + color, title), text('msg-m', 'font-size:11px;color:#c9ced8;margin-top:8px', msg.slice(0, 600))]
  }
}

// 一遍走完插件交来的树（手环上每走一遍整棵树都要十几毫秒），收集：
//   depth   View 嵌套几层（根算第 1 层）
//   nested  根以外有没有 Pager（模板里只给根节点留了 swiper）
//   images  用到的图片哈希
//   sprites 动画节点 {id: {sig: 帧签名, frames: [图片地址], ms: 一轮多久}}
function scan(tree) {
  const out = { depth: 0, nested: false, images: [], sprites: {} }
  const image = (src) => {
    if (src && src.indexOf(FILES) === 0) out.images.push(src.slice(FILES.length, src.lastIndexOf('.')))
  }
  const walk = (n, d) => {
    if (d > out.depth) out.depth = d
    image(n.u)
    if (n.f) {
      n.f.forEach((f) => image(f.src))
      if (n.t === 'a') {
        const frames = n.f.map((f) => f.src)
        out.sprites[n.i] = { sig: frames.join(',') + '|' + n.d, frames, ms: durationMs(n.d) }
      }
    }
    ;(n.c || []).forEach((c) => {
      if (c.t === 'w') out.nested = true
      walk(c, c.t === 'v' ? d + 1 : d)
    })
  }
  walk(tree, 1)
  return out
}

// '900ms' / '1.5s' / 900 → 毫秒
function durationMs(d) {
  const v = parseFloat(d) || 1000
  return /[^m]s$/.test(String(d)) ? v * 1000 : v
}

// 每个节点都带上全部字段：页面上的树是响应式的，事后才加的字段不会触发更新（patch 只改已有字段）
const EMPTY = { s: '', x: '', u: '', f: [], d: '', e: 0, vt: true, ix: 0, c: [] }
// 页面上每个节点（按 id）上次是照着插件交来的哪个对象画的。插件运行时复用没变的组件时交来的是同一个对象，
// 一样就整棵子树跳过不比
let SRC = {}
// 页面上的节点对象（按 id），播动画时改它的 u
let NODES = {}
// k：模板里按它复用元素（tid）。平时就是 id；要重建元素时换一个新的 k
let KSEQ = 0
let NEWN = 0 // 这次画树新建了几个节点（点击日志用）
// 样式变了的节点要不要重建（见 patch）：只有小米手环 9 Pro 要，layout() 里按手环型号设
let REBUILD = false
function normalize(n, k) {
  NEWN++
  SRC[n.i] = n
  const out = Object.assign({}, EMPTY, n)
  out.k = k || n.i
  if (n.t === 'a') out.u = n.f && n.f.length > 0 ? n.f[0].src : ''
  out.c = (n.c || []).map((c) => slot(normalize(c)))
  NODES[n.i] = out
  return out
}

// 样式串 a 变成 b 要改的那几项（'k:v;k:v'）；b 里去掉了 a 的某项时返回 null
function styleDelta(a, b) {
  const parse = (str) => {
    const m = {}
    str.split(';').forEach((part) => {
      const i = part.indexOf(':')
      if (i > 0) m[part.slice(0, i)] = part.slice(i + 1)
    })
    return m
  }
  const ma = parse(a)
  const mb = parse(b)
  for (const k in ma) if (!(k in mb)) return null
  const out = []
  for (const k in mb) if (ma[k] !== mb[k]) out.push(k + ':' + mb[k])
  return out.join(';')
}

// 子节点放在槽里，重建节点时只换槽里的 w（见 tools/gen_template.py 的 level）
function slot(node) {
  return { k: node.i, w: [node] }
}

function sameFrames(a, b) {
  if (a.length !== b.length) return false
  for (let i = 0; i < a.length; i++) if (a[i].src !== b[i].src) return false
  return true
}

// 把插件新交的树（字段不全）的变化写进页面上正在画的树（字段齐全），返回放在这个位置的节点。
// 只改变了的字段，框架只更新这些绑定。缺的字段当默认值比，不用先把整棵新树补全一遍。
// 小米手环 9 Pro 上样式变了的节点不在原元素上改，整个重建（换新的 k，返回新节点）：9 Pro 上改了已经画出来的元素的样式，
// 之后别处的文字一变排版就乱（元素挤到页面顶上，重新打开页面才好）；新建的元素排版是对的。
// 子节点按 id 对上：对上的接着比，新出现的补全
const FIELDS = ['x', 'u', 'd', 'e', 'vt', 'ix']
function patch(old, neu) {
  if (SRC[old.i] === neu) return old
  const s = neu.s === undefined ? EMPTY.s : neu.s
  const full = old.fs === undefined ? old.s : old.fs
  if (full !== s) {
    if (REBUILD) {
      // 9 Pro：只把变了的几项写进绑定的样式（框架只设这几项，排版属性不动）；有属性被去掉的没法这样表达，整个重建
      const delta = styleDelta(full, s)
      if (delta === null) return normalize(neu, neu.i + '~' + (++KSEQ))
      old.fs = s
      old.s = delta
    } else old.s = s
  }
  SRC[old.i] = neu
  NODES[old.i] = old
  FIELDS.forEach((k) => {
    if (k === 'u' && old.t === 'a') return // 动画的当前帧由 startSprites 换
    const v = neu[k] === undefined ? EMPTY[k] : neu[k]
    if (old[k] !== v) old[k] = v
  })
  const f = neu.f || EMPTY.f
  if (!sameFrames(old.f, f)) old.f = f
  const a = old.c
  const byId = {}
  a.forEach((sl) => (byId[sl.w[0].t + sl.w[0].i] = sl))
  const b = (neu.c || []).map((c) => {
    const sl = byId[c.t + c.i]
    if (!sl) return slot(normalize(c))
    const node = patch(sl.w[0], c)
    if (node !== sl.w[0]) sl.w = [node]
    return sl
  })
  let same = a.length === b.length
  for (let i = 0; same && i < a.length; i++) same = a[i] === b[i]
  if (!same) old.c = b
  return old
}

export default {
  private: {
    root: null,
    connected: false,
    pageH: 360
  },

  onInit() {
    this.plugins = [] // Mac 发来的插件列表
    this.stores = {}
    this.data = {} // 插件的 storage：{插件名: {key: value}}
    this.active = 0
    this.insts = {} // 插件名 → 正在跑的实例 {name, code, rt, tree, err}
    this.waiting = null // 等图片到了再画的树
    this.have = {} // 手环上已有的代码和图片
    this.asked = {} // 已经向 Mac 要过的哈希 → 时间
    this.parts = {}
    this.anims = {} // 正在播的动画：{id: {sig, node, timer}}
    this.pagerAt = {} // Pager（swiper）实际停在第几页：{id: 页码}，以 swiper 报上来的为准
    this.lastTap = 0
    this.heard = false // 这次 hello 之后收到过 Mac 的消息没有
    this.helloSeq = 0
    this.sendErrs = [] // 发送失败的记录，Mac 有回应后发过去记日志
    this.conn = interconnect.instance()
    this.conn.onopen = () => {
      this.connected = true
      this.hello()
    }
    this.conn.onclose = () => { this.connected = false }
    this.conn.onerror = () => { this.connected = false }
    this.conn.onmessage = (msg) => {
      let m = msg && msg.data
      try {
        if (typeof m === 'string') m = JSON.parse(m)
      } catch (e) {
        return
      }
      if (!m) return
      if (!this.heard) {
        this.heard = true
        if (this.sendErrs.length > 0) {
          this.log('', 'warn', '发给 Mac 失败过：' + this.sendErrs.join('，'))
          this.sendErrs = []
        }
      }
      this.handle(m)
    }
  },

  onShow() {
    this.asked = {}
    this.stopSprites()
    const ready = () => this.layout(() => this.listFiles(() => {
      this.show()
      this.hello()
    }))
    if (this.plugins.length > 0) return ready()
    // 先用上次的插件和数据把界面画出来，不用等 Mac
    storage.get({
      key: CACHE_KEY,
      success: (v) => {
        try {
          const c = JSON.parse(v)
          this.plugins = c.plugins || []
          this.stores = c.stores || {}
          this.data = c.data || {}
          this.active = c.active || 0
        } catch (e) {}
        ready()
      },
      fail: () => ready()
    })
  },

  onHide() {
    this.stopSprites()
    this.save()
    this.send({ t: 'bye' })
  },

  onDestroy() {
    this.stopSprites()
    this.send({ t: 'bye' })
  },

  onBackPress() {
    this.send({ t: 'bye' })
    this.$app.exit()
    return true
  },

  save() {
    storage.set({ key: CACHE_KEY, value: JSON.stringify({ plugins: this.plugins, stores: this.stores, data: this.data, active: this.active }) })
  },

  send(obj) {
    const fail = (d, code) => {
      if (this.sendErrs.length >= 5) return
      let why = code === undefined ? d : code
      try {
        if (typeof why === 'object') why = JSON.stringify(why)
      } catch (e) {}
      this.sendErrs.push(obj.t + ' ' + why)
    }
    try {
      this.conn.send({ data: obj, success: () => {}, fail })
    } catch (e) {
      fail(e && e.message ? e.message : e)
    }
  },

  // Mac 收到 hello 才开始发插件和数据（会马上回插件列表）。有的手环（小米手环 9 Pro）刚连上时发的消息会丢，
  // 没等到回应就每秒重发，最多 10 次
  hello() {
    const seq = ++this.helloSeq
    this.heard = false
    const say = (tries) => {
      if (seq !== this.helloSeq || this.heard) return
      this.send({ t: 'hello', w: 212, h: this.pageH, have: Object.keys(this.have) })
      const p = this.plugins[this.active]
      if (p) this.send({ t: 'nav', name: p.name })
      if (tries < 10) setTimeout(() => say(tries + 1), 1000)
    }
    say(1)
  },

  log(name, level, msg) {
    this.send({ t: 'log', p: name, level, msg: String(msg).slice(0, 800) })
  },

  // ---------- 收消息 ----------

  handle(m) {
    switch (m.t) {
      case 'plugins':
        this.connected = true
        this.plugins = m.list || []
        if (this.active >= this.plugins.length) this.active = 0
        this.show()
        break
      case 'store':
        this.stores[m.name] = m.v
        Object.keys(this.insts).forEach((k) => this.insts[k].rt.setStore(m.name, m.v))
        break
      case 'blob':
        this.blobChunk(m)
        break
      case 'show':
        this.go(this.plugins.findIndex((p) => p.name === m.name))
        break
      case 'vib':
        vibrator.vibrate({ mode: m.m === 'long' ? 'long' : 'short' })
        break
    }
  },

  blobChunk(m) {
    const p = this.parts[m.h] || (this.parts[m.h] = { list: [], got: 0 })
    if (p.list[m.k] === undefined) p.got++
    p.list[m.k] = m.b
    if (p.got < m.n) return
    delete this.parts[m.h]
    file.writeArrayBuffer({
      uri: FILES + m.h + '.' + m.x,
      buffer: b64decode(p.list.join('')),
      success: () => {
        this.have[m.h] = true
        delete this.asked[m.h]
        this.blobArrived()
      },
      fail: (d, code) => this.log('', 'error', '写文件失败 ' + m.h + ' ' + code)
    })
  },

  // 缺的代码或图片到了：当前页在等它就接着画
  blobArrived() {
    if (this.waiting) {
      const tree = this.waiting
      this.waiting = null
      this.showTree(tree)
      return
    }
    const p = this.plugins[this.active]
    if (p && !this.insts[p.name] && this.have[p.code]) this.show()
  },

  need(hashes) {
    const now = Date.now()
    const list = hashes.filter((h) => !this.have[h] && !(this.asked[h] && now - this.asked[h] < 10000))
    if (list.length === 0) return
    list.forEach((h) => { this.asked[h] = now })
    this.send({ t: 'need', h: list })
  },

  listFiles(done) {
    file.list({
      uri: FILES,
      success: (d) => {
        ;(d.fileList || []).forEach((f) => {
          const m = /([0-9a-f]+)\.(png|js)$/.exec(f.uri || '')
          if (m) this.have[m[1]] = true
        })
        done()
      },
      fail: () => done()
    })
  },

  // ---------- 跑插件 ----------

  // 显示当前页：插件已经在跑就直接画它的树，否则加载代码
  show() {
    const p = this.plugins[this.active]
    if (!p) {
      this.root = this.connected ? messageTree('没有插件', '', '#c9ced8') : null
      return
    }
    if (p.err) return this.showTree(messageTree(p.title + ' 出错了', p.err, '#ff9f1c'))
    const inst = this.insts[p.name]
    if (inst && inst.code === p.code) {
      if (inst.err) return this.showTree(messageTree(p.title + ' 出错了', inst.err, '#ff9f1c'))
      if (inst.tree) this.showTree(inst.tree)
      return
    }
    if (!this.have[p.code]) {
      this.need([p.code])
      return
    }
    file.readText({
      uri: FILES + p.code + '.js',
      success: (d) => this.start(p, d.text),
      fail: () => {
        delete this.have[p.code]
        this.need([p.code])
      }
    })
  },

  start(p, code) {
    if (this.insts[p.name] && this.insts[p.name].code === p.code) return
    const inst = { name: p.name, code: p.code, tree: null, err: null }
    const onError = (msg) => {
      inst.err = msg
      this.log(p.name, 'error', msg)
      if (this.insts[p.name] === inst && this.isActive(p.name)) this.showTree(messageTree(p.title + ' 出错了', msg, '#ff9f1c'))
    }
    const rt = createRuntime({
      render: (tree, timing) => {
        inst.tree = tree
        inst.err = null
        if (this.insts[p.name] === inst && this.isActive(p.name)) this.showTree(tree, timing)
      },
      error: onError,
      log: (level, msg) => this.log(p.name, level, msg),
      asset: (path) => {
        const h = (p.assets || {})[String(path).replace(/^\.\//, '')]
        if (!h) throw new Error('插件里没有这个图片：' + path)
        return FILES + h + '.png'
      },
      vibrate: (mode) => {
        if (this.isActive(p.name)) vibrator.vibrate({ mode: mode === 'long' ? 'long' : 'short' })
      },
      call: (name, args) => this.send({ t: 'call', p: p.name, name, args }),
      scope: p.name + ':',
      storageGet: (key) => (this.data[p.name] || {})[key],
      storageSet: (key, value) => {
        if (!this.data[p.name]) this.data[p.name] = {}
        this.data[p.name][key] = value
      }
    })
    inst.rt = rt
    this.insts[p.name] = inst
    try {
      const mod = { exports: {} }
      const require = (name) => {
        if (name === 'miband') return rt.api
        throw new Error('只能 require("miband")，不支持 ' + name)
      }
      new Function('module', 'exports', 'require', 'console', '__h', '__Fragment', code)(mod, mod.exports, require, rt.api.console, rt.api.h, rt.api.Fragment)
      const component = mod.exports.default
      if (typeof component !== 'function') throw new Error('插件要 export default 一个组件函数')
      Object.keys(this.stores).forEach((k) => rt.setStore(k, this.stores[k]))
      rt.setStore('screen', { width: 212, height: this.pageH })
      rt.mount(component)
    } catch (e) {
      onError('加载出错：' + (e && e.message ? e.message : e))
    }
  },

  isActive(name) {
    const p = this.plugins[this.active]
    return !!p && p.name === name
  },

  // 画一棵树：图片都在手环上了才画，缺的先向 Mac 要
  // timing：插件运行时这次渲染各步的耗时（见 runtime.js 的 render），点击后记日志用
  showTree(tree, timing) {
    if (!tree) return
    const tc = Date.now()
    let info = scan(tree)
    if (info.depth > MAX_DEPTH || info.nested) {
      tree = info.nested
        ? messageTree('Pager 只能放在最外层', '插件返回的根组件是 Pager 时才能翻页', '#ff9f1c')
        : messageTree('界面嵌套太深', '最多 ' + MAX_DEPTH + ' 层 View', '#ff9f1c')
      info = scan(tree)
    }
    const missing = info.images.filter((h) => !this.have[h])
    if (missing.length > 0) {
      this.waiting = tree
      this.need(missing)
      return
    }
    this.waiting = null
    const t0 = Date.now()
    const same = this.root && this.root.i === tree.i && this.root.t === tree.t
    NEWN = 0
    const root = same ? patch(this.root, tree) : normalize(tree)
    if (root !== this.root) {
      if (!same) NODES = {}
      this.root = root
      this.pagerAt = {} // 新建的 swiper 从第 0 页开始
    }
    this.startSprites(info.sprites)
    this.syncPager(tree)
    // 点了之后多久把新界面交给框架；超过 200ms 分步发回 Mac 记一笔（找慢在哪）
    if (this.tapAt) {
      const end = Date.now()
      const tm = timing || {}
      const step = (name, ms) => (ms === undefined ? '' : ' ' + name + ' ' + ms)
      const tapAt = this.tapAt
      const created = NEWN
      // 框架：交给框架后 JS 线程还被占了多久（下一个计时器多久才轮到）
      setTimeout(() => {
        const done = Date.now()
        if (done - tapAt <= 200) return
        this.log('', 'info', '点击到界面更新 ' + (done - tapAt) + 'ms：' +
          step('事件', tm.at === undefined ? undefined : tm.at - tapAt) + step('插件代码', tm.comp) + step('转节点', tm.build) +
          step('样式', tm.style) + step('检查', t0 - tc) + step('更新', end - t0) + step('框架', done - end) + step('新建节点', created))
      }, 0)
      this.tapAt = 0
    }
  },

  go(i) {
    if (i < 0 || i >= this.plugins.length || i === this.active) return
    this.active = i
    this.waiting = null
    this.stopSprites()
    this.pagerAt = {}
    this.show()
    this.send({ t: 'nav', name: this.plugins[i].name })
  },

  // ---------- 交互：都在手环上处理 ----------

  activeRuntime() {
    const p = this.plugins[this.active]
    const inst = p && this.insts[p.name]
    return inst && inst.rt
  },

  tap(id, ev) {
    if (!(ev & 1)) return
    // click 会冒泡：里外两层都能点时只算最里面那个
    const now = Date.now()
    if (now - this.lastTap < 150) return
    this.lastTap = now
    const rt = this.activeRuntime()
    this.tapAt = now
    if (rt) rt.dispatch(id, 'click')
  },

  // Pager 翻页了（swiper 的 change 事件带着 index）：先记下 swiper 停在哪，再告诉插件
  pageChange(id, ev, evt) {
    if (!evt) return
    this.pagerAt[id] = evt.index
    if (!(ev & 4)) return
    const rt = this.activeRuntime()
    if (rt) rt.dispatch(id, 'change', evt.index)
  },

  // 插件要的页（ix）和 swiper 实际停的页不一样时（比如点了按钮要翻到第 2 页），让 swiper 翻过去。
  // 用户自己翻的页插件跟着更新，两边一样，就不会再去动 swiper
  syncPager(tree, tries) {
    if (!tree || tree.t !== 'w') return
    const want = tree.ix || 0
    if ((this.pagerAt[tree.i] || 0) === want) return
    let el = null
    try {
      el = this.$element(tree.i)
    } catch (e) {}
    if (!el) {
      // 新建的 swiper 可能还没建好
      if ((tries || 0) < 20) setTimeout(() => this.syncPager(tree, (tries || 0) + 1), 50)
      return
    }
    this.pagerAt[tree.i] = want
    try {
      el.swipeTo({ index: want })
    } catch (e) {}
  },

  hold(id, ev) {
    if (!(ev & 2)) return
    const now = Date.now()
    if (now - this.lastTap < 150) return
    this.lastTap = now
    const rt = this.activeRuntime()
    if (rt) rt.dispatch(id, 'longpress')
  },

  // 右滑退出（系统手势可能被子元素吃掉，自己处理）；其它方向交给插件
  onSwipe(e) {
    const d = e.direction
    if (d === 'right') {
      this.send({ t: 'bye' })
      this.$app.exit()
      return
    }
    const rt = this.activeRuntime()
    if (rt) rt.swipe(d)
  },

  // 动画（Sprite）画成普通 image，这里定时换它的图片地址播帧。不用 image-animator：
  // 小米手环 9 Pro 上页面开着时拆掉一个 image-animator（换动画、切插件）整个手环会重启。
  // sprites：树里的动画节点（scan 收集的）。新出现的、换了帧的从第一帧播，不在树里的停掉；
  // 页面上的节点对象换了（整段子节点重建过）也重新开始，旧的计时器改的是已经不画的对象
  startSprites(sprites) {
    Object.keys(this.anims).forEach((id) => {
      const a = this.anims[id]
      if (!sprites[id] || sprites[id].sig !== a.sig || NODES[id] !== a.node) this.stopSprite(id)
    })
    Object.keys(sprites).forEach((id) => {
      if (!this.anims[id]) this.startSprite(id, sprites[id])
    })
  },

  startSprite(id, sp) {
    const node = NODES[id]
    if (!node) return
    const a = { sig: sp.sig, node, timer: 0 }
    this.anims[id] = a
    if (sp.frames.length === 0) return
    node.u = sp.frames[0]
    if (sp.frames.length < 2) return
    let i = 0
    a.timer = setInterval(() => {
      i = (i + 1) % sp.frames.length
      node.u = sp.frames[i]
    }, Math.max(50, Math.round(sp.ms / sp.frames.length)))
  },

  stopSprite(id) {
    clearInterval(this.anims[id].timer)
    delete this.anims[id]
  },

  // 熄屏、离开、换插件时停掉所有动画；再画树时重新开始
  stopSprites() {
    Object.keys(this.anims).forEach((id) => this.stopSprite(id))
  },

  layout(done) {
    device.getInfo({
      success: (info) => {
        REBUILD = /Band 9/i.test(String(info.product || ''))
        const w = info.screenWidth || 0
        const h = info.screenHeight || 0
        if (w > 0 && h > 0) this.pageH = Math.round(h / (w / 212))
        Object.keys(this.insts).forEach((k) => this.insts[k].rt.setStore('screen', { width: 212, height: this.pageH }))
        done()
      },
      fail: () => done()
    })
  }
}
</script>

<style>
.page {
  width: 212px;
  flex-direction: column;
  background-color: #000000;
}

.empty {
  margin-top: 120px;
  width: 212px;
  font-size: 13px;
  color: #5c6068;
  text-align: center;
}

.offline {
  position: absolute;
  top: 2px;
  left: 0px;
  width: 212px;
  font-size: 10px;
  color: #ff6b6b;
  text-align: center;
}
</style>
